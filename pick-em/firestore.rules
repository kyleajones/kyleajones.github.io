rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Read-only mirror of each currently-published game's real matchup
    // data (team names, spread/total lines, kickoff time, and the
    // week/year it belongs to). Written only by update_picks.py via the
    // Admin SDK, which bypasses these rules entirely -- clients never
    // write here. Exists so /picks/{pickId} below can validate submitted
    // picks against real game data, since rules can't read
    // matchups.json (a static file served over HTTP, not a Firestore
    // document) -- they can only get()/exists() other Firestore docs.
    match /matchups/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // Read-only mirror of the pre-computed season leaderboard (one entry
    // per player: name, points, w/l/p record), written only by
    // update_leaderboard.py via the Admin SDK, which bypasses these
    // rules entirely. Exists so the public leaderboard can be served
    // without any client ever needing to scan/read other players'
    // individual /picks documents -- see the read rule on /picks below.
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Read-only mirror of one week's picks, keyed by player uid, written
    // only by update_weekly_picks.py via the Admin SDK. Already redacted
    // server-side before it's ever written here: a player's entry only
    // includes pick keys for games that had already kicked off at
    // compute time, so exposing this whole document publicly leaks
    // nothing that a game's own kickoff time hasn't already made public.
    match /weeklyPicks/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Cross-collection path to a game's matchup mirror doc, for use with
    // get()/exists().
    function matchupPath(gameId) {
      return /databases/$(database)/documents/matchups/$(gameId);
    }

    // True if `key` already existed in the stored document with the
    // exact same value it has in the incoming write -- the same
    // carry-forward exemption auth.js's merge logic relies on for UX
    // (an untouched pick on an already-started game must remain
    // saveable on every subsequent save, even though it would fail a
    // fresh validity check below).
    function pickUnchanged(key) {
      return resource != null
             && key in resource.data.picks
             && resource.data.picks[key] == request.resource.data.picks[key];
    }

    // True only if `key` (e.g. "spread_<gameId>" or "ou_<gameId>") refers
    // to a real game that belongs to THIS document's own week/year, that
    // game hasn't started yet, and `value` exactly matches one of the
    // legitimate selections derivable from the mirrored line data FOR THAT
    // KEY'S OWN PICK TYPE.
    //
    // The pick type matters: this used to accept any of the four values
    // for either prefix, so "spread_<gameId>" = "Under|0" passed. The
    // graders then read "Under" as a team name, fell through to the home
    // side, and scored the total as though it were a spread -- a forged
    // guaranteed win. The graders now reject that too (grade_pick() in
    // pickem_common.py / gradePick() in grading.js), but it shouldn't be
    // storable in the first place.
    //
    // An unpriced line ("N/A", what espn_api._format_spread() writes when
    // ESPN has published no odds) is rejected outright: it isn't a real
    // line, so there's no honest way to grade a pick against it. That
    // falls out of validPicks being an empty list for such a side.
    //
    // The legitimate values are precomputed server-side by
    // update_picks.valid_picks_map() into
    // matchup.data.validPicks = {spread: [...], ou: [...]}, so this is a
    // single map lookup plus a list membership test. Rebuilding those
    // strings inline here (regex + ternary + four concatenations, per
    // pick) is what exceeded Firestore's 1000-expression-per-evaluation
    // limit on a 7-pick update -- see the budget note on allPicksOk().
    function pickIsValid(key, value, weekStr, yearStr) {
      let prefix = key.split('_')[0];
      let matchup = get(matchupPath(key.split('_')[1]));
      return matchup != null
             && matchup.data.weekStr == weekStr
             && matchup.data.yearStr == yearStr
             && request.time < matchup.data.commenceTime
             && prefix in matchup.data.validPicks
             && value in matchup.data.validPicks[prefix];
    }

    function pickOk(key, weekStr, yearStr) {
      return pickUnchanged(key) || pickIsValid(key, request.resource.data.picks[key], weekStr, yearStr);
    }

    // "all()" over picks.keys() -- the rules language has no built-in
    // loop or all()/any() over map entries, and (unlike some other rules
    // examples floating around) does NOT allow a function to call
    // itself -- Firestore's rules compiler rejects that outright
    // ("Recursive call is not allowed"). So this is unrolled by hand
    // across 7 indices, matching the existing `picks.size() <= 7` cap
    // enforced below: each clause is trivially true once `keys` is
    // shorter than that index, via `||` short-circuiting before the
    // (otherwise out-of-bounds) `keys[i]` access is ever evaluated.
    //
    // EVALUATION BUDGET -- there are TWO separate per-evaluation limits
    // here, and both are easy to trip because exceeding either fails the
    // write with permission-denied, indistinguishable from a legitimate
    // rule rejection:
    //
    //   1. 10 document access calls (get/exists).
    //   2. 1000 expressions evaluated.
    //
    // Limit 1 is why pickIsValid() and matchupStarted() null-check a
    // single get() rather than calling exists() first on the same path:
    // that pair cost 2 accesses per pick, putting a 7-pick save at ~16.
    // Worst case now is 7 (one per pick) + 1 (lockIsFrozen, only when a
    // lock is already stored) = 8 of 10.
    //
    // Limit 2 was hit for real, by a 7-pick UPDATE -- CI caught it after
    // limit 1 had already been fixed, which is exactly why the two have
    // to be tracked separately. Each pick pays pickUnchanged() (3
    // expressions, only short-circuiting cheaply on create, where
    // resource == null) AND pickIsValid(); rebuilding the legitimate
    // pick strings inline there (a regex match, a ternary, and four
    // string concatenations against the mirror doc) multiplied out past
    // 1000 across 7 keys. Hence validPicks: the string building moved
    // server-side into update_picks.valid_picks_map(), leaving the rule
    // a map lookup and a list membership test.
    //
    // Neither limit can be raised. If MAX_PICKS ever goes above 7, or a
    // helper gains a get() or any non-trivial per-pick expression, BOTH
    // budgets need rechecking -- and the only reliable check is running
    // the 7-pick tests in tests/rules/picks.test.js against the
    // emulator, since neither cost is visible by reading the file.
    function allPicksOk(keys, weekStr, yearStr) {
      return (keys.size() < 1 || pickOk(keys[0], weekStr, yearStr))
             && (keys.size() < 2 || pickOk(keys[1], weekStr, yearStr))
             && (keys.size() < 3 || pickOk(keys[2], weekStr, yearStr))
             && (keys.size() < 4 || pickOk(keys[3], weekStr, yearStr))
             && (keys.size() < 5 || pickOk(keys[4], weekStr, yearStr))
             && (keys.size() < 6 || pickOk(keys[5], weekStr, yearStr))
             && (keys.size() < 7 || pickOk(keys[6], weekStr, yearStr));
    }

    // True if `gameId`'s mirrored matchup exists and has already kicked
    // off. Spends a single document access (one get(), null-checked)
    // rather than the exists()+get() pair on the same path this replaced
    // -- see the access-budget note on allPicksOk().
    function matchupStarted(gameId) {
      let matchup = get(matchupPath(gameId));
      return matchup != null && request.time >= matchup.data.commenceTime;
    }

    // True if the EXISTING document's lockedPick references a game that
    // has already started -- once true, that lock must freeze, matching
    // the same fairness pattern already applied to picks themselves
    // (freeze server-side at kickoff, not just via client-side disabled
    // radios). The && chain short-circuits before matchupStarted(), so
    // the get() is only spent when there's actually a stored lock.
    function lockIsFrozen() {
      return resource != null
             && 'lockedPick' in resource.data
             && resource.data.lockedPick != null
             && matchupStarted(resource.data.lockedPick.split('_')[1]);
    }

    // lockedPick, if present, must be null or a real key in picks (kept
    // honest as defense-in-depth, since a dangling/forged value would
    // just never match anything in record.js's grading loop anyway) --
    // and once lockIsFrozen(), the incoming lockedPick must be unchanged
    // from what's already stored.
    function lockedPickOk() {
      return (!('lockedPick' in request.resource.data)
              || request.resource.data.lockedPick == null
              || request.resource.data.lockedPick in request.resource.data.picks)
             && (!lockIsFrozen() || request.resource.data.lockedPick == resource.data.lockedPick);
    }

    match /picks/{pickId} {
      // Owner-only: a player may only read their own pick documents. The
      // public leaderboard is served from the pre-computed /leaderboard/
      // current mirror instead (see above), so no client -- logged in or
      // not -- ever needs to read another player's individual picks,
      // including picks for games that haven't started yet.
      // `resource == null` (doc doesn't exist yet, e.g. a user's first
      // visit for a given week) must be allowed explicitly: accessing
      // `resource.data` when resource is null throws a rules evaluation
      // error, which Firestore reports as permission-denied rather than
      // a graceful "not found" -- breaking auth.js's snap.exists() check
      // on the prefill getDoc(). Allowing it here leaks nothing, since a
      // nonexistent doc has no data to expose.
      allow read: if request.auth != null
                  && (resource == null || resource.data.userId == request.auth.uid);

      // A user may only create their own pick document, AND the document ID
      // must actually belong to them (uid_weekN_year). Without the pickId
      // check, another logged-in player could pre-create a doc at a
      // player's future week ID (their uid is visible via the public
      // leaderboard's /leaderboard/current doc) and permanently block that
      // player's real submission, since `update` would then see a
      // mismatched owner.
      // Also cap total picks at 7 — the only tamper-proof enforcement of
      // the "Pick 7" rule, since client-side checks can be bypassed.
      // allPicksOk() cross-checks every pick against the real matchups/
      // mirror: it must reference a real game in THIS doc's own
      // week/year that hasn't started yet, with a value that matches a
      // real published line -- unless the value is unchanged from what's
      // already stored (pickUnchanged), the same carry-forward exemption
      // the client's merge logic depends on. This is also what makes a
      // fabricated/never-real week, or a stale already-finished week,
      // fail every pick automatically: neither has any matching
      // not-yet-started game in the mirror. lockedPickOk() keeps
      // lockedPick honest and frozen once its game starts.
      //
      // The >= 1 lower bound is what stops an empty-picks doc at a
      // fabricated week/year (e.g. "<uid>_week999_9999") from being
      // created at all: allPicksOk() vacuously passes on an empty map,
      // since there are no picks to find a mirrored game for, so size()
      // is the only thing standing between that and a junk 0-point row
      // on the leaderboard. auth.js already refuses to submit zero
      // picks client-side ("You must make at least one pick"), so this
      // rejects nothing a legitimate client would ever send.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.picks.size() >= 1
                    && request.resource.data.picks.size() <= 7
                    && pickId.matches(request.auth.uid + '_week[0-9]+_[0-9]+')
                    && lockedPickOk()
                    && allPicksOk(request.resource.data.picks.keys(), pickId.split('_')[1], pickId.split('_')[2]);

      // Require the existing document, the incoming data, AND the document
      // ID to all match the authenticated user. Also bound total picks to
      // 1..7, and apply the same lockedPickOk()/allPicksOk() checks as
      // create -- an update must not be able to empty out a doc either,
      // which would otherwise be a way to retroactively withdraw a losing
      // week's picks.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.picks.size() >= 1
                    && request.resource.data.picks.size() <= 7
                    && pickId.matches(request.auth.uid + '_week[0-9]+_[0-9]+')
                    && lockedPickOk()
                    && allPicksOk(request.resource.data.picks.keys(), pickId.split('_')[1], pickId.split('_')[2]);

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
